# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Env & secrets
.env
.env.*
!.env.example

# Test corpus — real personal data, never commit
data/corpus/*
!data/corpus/.gitkeep
# Unanchored too: a corpus dropped at any depth must never be committable.
**/data/corpus/*
!**/data/corpus/.gitkeep

# The gold-set draft carries extracted previews of those same personal files.
# The finished GOLD.jsonl is committed; the draft never is.
docs/GOLD.jsonl.draft
*.draft

# Sample documents used for manual verification. Third-party PDFs, not ours to commit.
data/samples/*
!data/samples/.gitkeep

# OCR benchmark inputs - photos of books, whiteboards, handwriting. Personal.
data/ocr-bench/images/*
data/ocr-bench/refs/*
!data/ocr-bench/images/.gitkeep
!data/ocr-bench/refs/.gitkeep

# Eval output
data/eval-runs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# TS incremental build cache
*.tsbuildinfo

# Stored uploads. Personal documents, content-addressed.
data/blobs/
