{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "apps/web",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "apps/api",
        "run",
        "uvicorn",
        "memora.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "api-rules",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "--directory",
        "apps/api",
        "run",
        "--env-file",
        ".env.rules",
        "uvicorn",
        "memora.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "port": 8000
    }
  ]
}
