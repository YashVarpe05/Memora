# Copy to .env and fill in. Never commit .env.
# CLAUDE.md rule: config from env only, never hardcoded.

ENVIRONMENT=development

# Postgres — host port 5433 (5432 is the local Windows Postgres service)
#
# Two roles on purpose. memora_app is NOSUPERUSER + NOBYPASSRLS so RLS policies
# actually bind; memora owns the schema and runs migrations. Pointing
# DATABASE_URL at memora makes every RLS policy silently inert.
DATABASE_URL=postgresql+asyncpg://memora_app:memora_app@localhost:5433/memora
MIGRATION_DATABASE_URL=postgresql+asyncpg://memora:memora@localhost:5433/memora

# Redis (arq job queue)
REDIS_URL=redis://localhost:6379/0

# LLM + embeddings
GEMINI_API_KEY=

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Google OAuth (Gmail connector). Keep the app in Testing mode with test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Encryption key for OAuth tokens at rest (Fernet)
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
